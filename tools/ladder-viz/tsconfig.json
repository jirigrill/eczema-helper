{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["svelte", "node"],
    "baseUrl": ".",
    "paths": { "$lib/*": ["../../src/lib/*"] }
  },
  "include": ["**/*.ts", "**/*.svelte"]
}
